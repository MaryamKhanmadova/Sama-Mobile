# Frontend defaults: deployable offline demo, no credentials needed.
VITE_DATA_MODE=demo
# API mode uses the server-side Netlify Edge proxy.
VITE_API_BASE_URL=/api
# Demo identity is enforced by the proxy, not trusted from the browser.
VITE_DEMO_MSISDN=+994981001644
# Set these ONLY in Netlify environment variables when backend is ready:
# SEMA_BACKEND_URL=https://your-app-runner-host.example.com
# SEMA_API_KEY=<web-backend-key>
# SEMA_ACCESS_TOKEN=<private-demo-login-code>
# SEMA_DEMO_MSISDN=+994981001644
# Do not prefix secrets with VITE_. Set VITE_DATA_MODE=api and rebuild to connect.
